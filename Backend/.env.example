PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/myapp

# Keep both credentials in the backend. Only the Key ID is returned to Checkout.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Checkout display methods; also enable the required methods in Razorpay Dashboard.
# Supported: upi,card,netbanking,wallet,emi,paylater
RAZORPAY_PAYMENT_METHODS=upi,card,netbanking,wallet

# Optional for local checkout, required for webhook recovery in deployment.
# Use a separate secret configured on the Razorpay Dashboard webhook.
RAZORPAY_WEBHOOK_SECRET=
