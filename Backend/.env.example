PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/myapp

# Firebase public web configuration used to verify Google/phone sign-in.
# Local development also reads the matching VITE_FIREBASE_* values from ../.env.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# Keep both credentials in the backend. Only the Key ID is returned to Checkout.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Checkout display methods; also enable the required methods in Razorpay Dashboard.
# Supported: upi,card,netbanking,wallet,emi,paylater
RAZORPAY_PAYMENT_METHODS=upi,card,netbanking,wallet,emi

# Optional: your approved per-order maximum in INR, including shipping/tax.
# Blank means the app does not impose a maximum; Razorpay still enforces its limits.
# Setting a larger number does not raise your Razorpay account limit.
RAZORPAY_MAX_AMOUNT_INR=

# Optional for local checkout, required for webhook recovery in deployment.
# Use a separate secret configured on the Razorpay Dashboard webhook.
RAZORPAY_WEBHOOK_SECRET=
